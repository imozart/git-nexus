{
  "name": "git-nexus",
  "version": "1.17.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "description": "GitNexus - gerenciador Git desktop portátil com governança de Conventional Commits e merge 3-way",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @git-nexus/studio dev",
    "build": "pnpm --filter @git-nexus/studio build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "pnpm --filter @git-nexus/studio ui-test",
    "test:e2e": "pnpm --filter @git-nexus/studio e2e",
    "dist": "pnpm --filter @git-nexus/studio dist"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
