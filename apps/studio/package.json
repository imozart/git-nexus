{
  "name": "@git-nexus/studio",
  "version": "1.6.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "productName": "GitNexus",
  "description": "GitNexus - gerenciador Git desktop portátil",
  "homepage": "https://github.com/imozart/git-nexus",
  "desktopName": "gitnexus.desktop",
  "author": "GitNexus <noreply@users.noreply.github.com>",
  "main": "dist/main.cjs",
  "scripts": {
    "build:node": "node scripts/build-node.mjs",
    "build:renderer": "vite build",
    "build": "pnpm build:node && pnpm build:renderer",
    "dev": "node scripts/dev.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "ui-test": "node scripts/ui-tests/run.mjs",
    "dist": "pnpm build && electron-builder --win",
    "pack:dir": "pnpm build && electron-builder --dir",
    "e2e": "node scripts/ui-tests/run-electron.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@git-nexus/git-core": "workspace:*",
    "@git-nexus/governance-policy": "workspace:*",
    "@git-nexus/ui-kit": "workspace:*",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "pinia": "^4.1.0",
    "sass": "^1.108.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
